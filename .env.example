# ── MongoDB (Atlas) ───────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com, then:
#   Database Access → add a user;  Network Access → allow your IP (or 0.0.0.0/0 for dev)
#   Connect → Drivers → copy the connection string and add the db name (/gymbro).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gymbro?retryWrites=true&w=majority"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
# In production set this to your deployed URL, e.g. https://gymbro.vercel.app
AUTH_URL="http://localhost:3000"

# ── Optional: Google OAuth ────────────────────────────────────────
# Leave blank to disable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional: Strava import ───────────────────────────────────────
# Leave blank to hide the Strava panel entirely. Cardio still works fully
# without it — manual entry, GPX import and live GPS tracking need no keys,
# and the map uses OpenStreetMap/CARTO tiles, which need no key either.
#
# To enable: https://www.strava.com/settings/api → "Create & Manage Your App"
#   Category:                     Training
#   Website:                      http://localhost:3000
#   Authorization Callback Domain: localhost      (just the host — no scheme, no path)
# For production, create a second app (or edit this one) with your deployed
# domain, e.g.  gymbro-padi.vercel.app
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ── AI Coach (chat widget) ────────────────────────────────────────
# The coach needs NO key. With none set it runs the keyless coach
# (src/lib/coach/local): answers quoted and cited from the research library
# (34 open-access papers, src/lib/data/COACH-SOURCES.md), plans from the
# programme generator, and a read of the user's real training log. It needs no
# outside service, and next.config.ts ships the model and library with the
# serverless function, so production runs the same code as localhost.
#
# A key is optional and only changes who writes the prose. Set either; with
# both, Anthropic wins unless COACH_PROVIDER says otherwise. Both engines get
# the research library as a `knowledge_search` tool.
#   Groq (cheap, fast, open models):  https://console.groq.com/keys
#   Anthropic (Claude):               https://console.anthropic.com/settings/keys
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# Which engine answers: "local" | "groq" | "anthropic". Leave blank to follow
# whichever key is present, falling back to "local" when there is none.
COACH_PROVIDER=""

# Optional, local only: a free Ollama model (https://ollama.com, no key) that
# rephrases the keyless coach's research answers conversationally. Its draft is
# discarded unless every number in it appears in the quoted papers. Vercel
# cannot reach it, so leave blank in production.
#   ollama pull qwen2.5:3b   then   OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_URL=""
OLLAMA_MODEL=""
# Override the Groq model (default openai/gpt-oss-120b — 131k context, tool use).
# openai/gpt-oss-20b is cheaper and faster if replies are good enough.
GROQ_MODEL=""

# Which coach backend answers the widget:
#   ts     — the Anthropic tool-runner loop inside this Next.js app (default)
#   python — proxy to the FastAPI + LangGraph service in backend/
COACH_BACKEND="ts"
# Only used when COACH_BACKEND=python:
COACH_PY_URL="http://127.0.0.1:8000"
# Shared secret the Next.js route sends as x-coach-token. Any long random
# string; the Python service refuses to answer without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COACH_SERVICE_TOKEN=""

# ── GymBro Fuel (nutrition module) ────────────────────────────────
# Fuel is ON by default. This is a kill switch, not a feature gate: set it to
# exactly "false" to hide the tab, 404 /fuel and refuse every /api/fuel route,
# without redeploying anything else. The strength tracker is unaffected either
# way. Leave it unset unless you need the off switch.
FUEL_ENABLED=""

# Free, issued instantly, no approval: https://fdc.nal.usda.gov/api-key-signup.html
# Only `npm run fuel:fetch` uses it — it builds src/lib/data/fuel-foods.json
# from USDA composition data. The running app never calls USDA, so production
# does not need this set. Without a key the fetch falls back to DEMO_KEY,
# which is capped at 10 requests/hour.
USDA_FDC_API_KEY=""

# Nothing in Fuel needs a key.
#   - Snap-a-meal runs a food model on the phone (public/models/food-v1/).
#   - "Describe your meal" parses amounts locally and finds foods through
#     ordinary search. If ANTHROPIC_API_KEY is set (AI Coach block above) it
#     uses Claude instead, which copes better with free-form sentences.
#   - Barcode lookups use Open Food Facts, which needs no key at all.
