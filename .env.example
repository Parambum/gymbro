# ── MongoDB (Atlas) ───────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com, then:
#   Database Access → add a user;  Network Access → allow your IP (or 0.0.0.0/0 for dev)
#   Connect → Drivers → copy the connection string and add the db name (/gymbro).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gymbro?retryWrites=true&w=majority"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
# In production set this to your deployed URL, e.g. https://gymbro.vercel.app
AUTH_URL="http://localhost:3000"

# ── Optional: Google OAuth ────────────────────────────────────────
# Leave blank to disable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional: Strava import ───────────────────────────────────────
# Leave blank to hide the Strava panel entirely. Cardio still works fully
# without it — manual entry, GPX import and live GPS tracking need no keys,
# and the map uses OpenStreetMap/CARTO tiles, which need no key either.
#
# To enable: https://www.strava.com/settings/api → "Create & Manage Your App"
#   Category:                     Training
#   Website:                      http://localhost:3000
#   Authorization Callback Domain: localhost      (just the host — no scheme, no path)
# For production, create a second app (or edit this one) with your deployed
# domain, e.g.  gymbro-padi.vercel.app
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ── AI Coach (chat widget) ────────────────────────────────────────
# Required for the coach. Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Which coach backend answers the widget:
#   ts     — the Anthropic tool-runner loop inside this Next.js app (default)
#   python — proxy to the FastAPI + LangGraph service in backend/
COACH_BACKEND="ts"
# Only used when COACH_BACKEND=python:
COACH_PY_URL="http://127.0.0.1:8000"
# Shared secret the Next.js route sends as x-coach-token. Any long random
# string; the Python service refuses to answer without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COACH_SERVICE_TOKEN=""
